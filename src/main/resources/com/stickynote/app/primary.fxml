<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.stickynote.app.PrimaryController"
           styleClass="stackpane-container">

   <BorderPane fx:id="borderPane"
               prefWidth="500" prefHeight="400"
               styleClass="note-container">

      <top>
         <HBox fx:id="topBar" spacing="5" alignment="CENTER"
               styleClass="top-bar">

            <!-- Left: New Note -->
            <Button onAction="#handleNewNote">
               <graphic>
                  <ImageView fitWidth="20" fitHeight="20">
                     <image>
                        <Image url="@/icons/add.png"/>
                     </image>
                  </ImageView>
               </graphic>
               <tooltip><Tooltip text="New note"/></tooltip>
            </Button>

            <!-- Spacer before center -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Center: Editable Title -->
            <HBox spacing="5" alignment="CENTER">
               <Label fx:id="noteTitleLabel" text="Untitled" styleClass="title-label" />
               <TextField fx:id="noteTitleField" promptText="Enter title..."
                          visible="false" styleClass="title-field" maxWidth="200" />
            </HBox>

            <!-- Spacer after center -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Right: Other Controls -->
            <HBox spacing="5" alignment="CENTER_RIGHT">
               <Button fx:id="notesListButton" onAction="#handleNotesList">
                  <graphic>
                     <ImageView fitWidth="20" fitHeight="20">
                        <image>
                           <Image url="@/icons/menu.png"/>
                        </image>
                     </ImageView>
                  </graphic>
                  <tooltip><Tooltip text="Open notes list"/></tooltip>
               </Button>

               <Button onAction="#handleMinimize">
                  <graphic>
                     <ImageView fitWidth="20" fitHeight="20">
                        <image>
                           <Image url="@/icons/mini.png"/>
                        </image>
                     </ImageView>
                  </graphic>
                  <tooltip><Tooltip text="Minimize note"/></tooltip>
               </Button>

               <Button onAction="#handleDeleteNote">
                  <graphic>
                     <ImageView fitWidth="20" fitHeight="20">
                        <image>
                           <Image url="@/icons/bin.png"/>
                        </image>
                     </ImageView>
                  </graphic>
                  <tooltip><Tooltip text="Delete note"/></tooltip>
               </Button>

               <Button onAction="#handleClose">
                  <graphic>
                     <ImageView fitWidth="20" fitHeight="20">
                        <image>
                           <Image url="@/icons/cross.png"/>
                        </image>
                     </ImageView>
                  </graphic>
                  <tooltip><Tooltip text="Close note"/></tooltip>
               </Button>

            </HBox>

         </HBox>
      </top>

      <center>
         <TextArea fx:id="noteArea" wrapText="true"/>
      </center>

   </BorderPane>
</StackPane>
